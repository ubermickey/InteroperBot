# No API key needed — InteroperBot uses the Claude CLI (your subscription)
# SYSTEM_PROMPT=You are a helpful assistant responding via iMessage. Keep responses concise and conversational.
# ALLOWED_CONTACTS=+15551234567,friend@icloud.com
# POLL_INTERVAL=2
# MAX_HISTORY=50
# CLI_TIMEOUT=120
# DB_PATH=~/.interoperbot/conversations.db
# CLAUDE_CLI=~/.local/bin/claude

# WhatsApp (Baileys bridge) — run: python bot.py --setup-whatsapp
# WHATSAPP_ENABLED=false
# WHATSAPP_BRIDGE_PORT=3456

# Web UI (embedded in bot.py when WEB_ENABLED=true)
# WEB_ENABLED=true
# WEB_PORT=8000
